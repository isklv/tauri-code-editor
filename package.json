{
  "name": "geko",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml && bun run build",
    "test:backend": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check:security": "bun scripts/security-check.js",
    "check:all": "bun scripts/security-check.js && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml && bun run build",
    "android:dev": "tauri android dev",
    "android:build": "bun scripts/build-apk.js",
    "android:build:universal": "bun scripts/build-apk.js --universal",
    "build:apk": "bun scripts/build-apk.js",
    "build:apk:universal": "bun scripts/build-apk.js --universal",
    "version": "bun scripts/version.js",
    "release": "bun scripts/release.js",
    "release:publish": "bun scripts/publish-release.js",
    "release:full": "bun scripts/release.js --publish"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "marked": "^18.0.13",
    "monaco-editor": "^0.52.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^5.4.0"
  }
}
