{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Geko",
  "version": "../package.json",
  "identifier": "dev.codeeditor.ide",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Geko",
        "width": 1200,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "fileAssociations": [
      {
        "ext": ["txt", "text", "md", "markdown", "log", "rs", "js", "ts", "jsx", "tsx", "html", "htm", "css", "scss", "json", "xml", "svg", "yaml", "yml", "toml", "ini", "conf", "cfg", "sh", "bash", "zsh", "py", "c", "h", "cpp", "hpp", "java", "kt", "go", "sql", "*"],
        "name": "All Files",
        "description": "All files",
        "role": "Editor",
        "mimeType": "text/plain"
      }
    ],
    "android": {
      "minSdkVersion": 24,
      "autoIncrementVersionCode": true
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
